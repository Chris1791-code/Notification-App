# Firebase Web SDK config — dùng chung config Web app (Firebase JS SDK chạy được trên Expo/React Native)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Giới hạn domain email được tự đăng ký, cách nhau bằng dấu phẩy. Để trống = không giới hạn.
# Vd: EXPO_PUBLIC_ALLOWED_EMAIL_DOMAINS=hcmut.edu.vn,oisp.hcmut.edu.vn
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAINS=
